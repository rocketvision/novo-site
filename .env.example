# Copie para .env.local (desenvolvimento) ou cadastre no painel da Vercel (produção).
# Nunca coloque valores reais neste arquivo: ele vai para o Git.

# URL pública do site, usada em canonical, Open Graph, sitemap, robots e nos links de convite e redefinição de senha.
NEXT_PUBLIC_SITE_URL=https://rocketvision.com.br

# Endereço próprio do CMS (opcional). Com ela, /cms só abre neste endereço e a raiz dele leva ao painel;
# convites e redefinições de senha apontam para cá. Sem ela, o CMS fica em /cms no endereço do site.
CMS_URL=

# Webhook que recebe as mensagens do formulário de contato (Make, Zapier, n8n, CRM...).
# Sem essa variável, o formulário mostra os canais diretos como alternativa.
CONTACT_WEBHOOK_URL=

# Neon Postgres (região aws-sa-east-1, São Paulo).
# DATABASE_URL: conexão com pooling (host com "-pooler"), usada pelo site.
# DATABASE_URL_UNPOOLED: conexão direta, usada só pelas migrations.
# Sem DATABASE_URL o site público continua no ar com o conteúdo embutido, e o CMS responde 503.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob: armazenamento das imagens enviadas pelo CMS (obrigatório em produção para uploads).
# Em desenvolvimento, sem o token, as imagens vão para public/uploads (fora do Git).
BLOB_READ_WRITE_TOKEN=

# Resend (opcional): envio de convites e links de redefinição de senha por e-mail.
# Sem estas variáveis, o CMS mostra o link para quem gerou copiar e enviar por outro canal.
RESEND_API_KEY=
MAIL_FROM=

# Somente desenvolvimento: bancos separados para os testes (os nomes precisam terminar em _test e _e2e).
DATABASE_URL_TEST=
DATABASE_URL_E2E=
